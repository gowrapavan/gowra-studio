# Copy to .env.local for local development. NEVER put real keys in this file:
# it is committed to GitHub. On Netlify, enter these in the dashboard instead
# (see DEPLOY.md). Values here are placeholders.

# ---- 1. Public site address (REQUIRED) ------------------------------------
# Your real address, no trailing slash. Drives canonical URLs, sitemap.xml,
# robots.txt, llms.txt and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 2. Search targeting (recommended) ------------------------------------
# The town or city you work in, e.g. Guntur. Adds it to the page title
# ("Website Designer & Developer in Guntur") and the search-engine data.
# Keep it short. Leave empty if you serve clients anywhere.
NEXT_PUBLIC_SERVICE_AREA=

# ---- 3. Receiving demo requests (REQUIRED for the contact form) -----------
# Option A: email through Resend (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# Option B: instant ping via Discord/Slack/Make/Zapier webhook
LEAD_WEBHOOK_URL=

# ---- 4. Public contact buttons (optional) ---------------------------------
# These are PUBLIC: anyone can read them in the page source.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- 5. Search engine ownership tags (add AFTER the site is live) ---------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
